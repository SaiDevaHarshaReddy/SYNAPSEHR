# Application
APP_NAME=SynapseHR
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
APP_SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://synapsehr:synapsehr@localhost:5432/synapsehr
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Configuration
AI_PROVIDER=openai
AI_MODEL=gpt-4
AI_API_KEY=your-ai-api-key
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Database
VECTOR_DB_TYPE=chromadb
VECTOR_DB_PATH=./chroma_db

# File Storage
UPLOAD_DIR=./uploads
GENERATED_DOCS_DIR=./generated_documents
KNOWLEDGE_DIR=./knowledge
MAX_UPLOAD_SIZE_MB=25

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=SynapseHR
SMTP_FROM_EMAIL=noreply@synapsehr.com
SMTP_USE_TLS=true

# CORS
CORS_ORIGINS=["http://localhost:4321","http://localhost:3000","https://synapsehrproject.vercel.app"]
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=20

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
