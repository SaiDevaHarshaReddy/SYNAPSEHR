---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Sidebar from '../components/common/Sidebar.astro';
import Header from '../components/common/Header.astro';
import MobileNav from '../components/common/MobileNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'SynapseHR', description } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || 'SynapseHR - AI-native HR Operations Platform'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      const applyTheme = () => {
        let theme = localStorage.getItem('theme') || 'dark';
        if (theme === 'system') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        if (theme === 'light') {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        }
      };
      
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="bg-slate-950 text-white font-sans antialiased min-h-screen">
    <!-- Toast Container -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2 max-w-sm" aria-live="polite" aria-label="Notifications"></div>

    <div class="flex h-screen overflow-hidden">
      <Sidebar />
      <div class="flex flex-col flex-1 overflow-hidden">
        <Header />
        <main class="flex-1 overflow-y-auto p-4 lg:p-6 pb-20 lg:pb-6" role="main">
          <slot />
        </main>
      </div>
    </div>

    <MobileNav />

    <script>
      function showToast(message: string, type: string = 'info', duration: number = 4000) {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const id = 'toast-' + Date.now();
        const colorMap: Record<string, string> = {
          success: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400',
          error: 'bg-red-500/10 border-red-500/30 text-red-400',
          warning: 'bg-amber-500/10 border-amber-500/30 text-amber-400',
          info: 'bg-indigo-500/10 border-indigo-500/30 text-indigo-400',
        };

        const iconMap: Record<string, string> = {
          success: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />',
          error: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />',
          warning: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />',
          info: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />',
        };

        const el = document.createElement('div');
        el.id = id;
        el.className = `flex items-center gap-3 px-4 py-3 rounded-xl border backdrop-blur-xl ${colorMap[type] || colorMap.info} toast-enter`;
        el.setAttribute('role', 'status');
        el.innerHTML = `
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">${iconMap[type] || iconMap.info}</svg>
          <span class="text-sm font-medium flex-1">${message}</span>
          <button onclick="this.parentElement.classList.replace('toast-enter','toast-exit');setTimeout(()=>this.parentElement.remove(),200)" class="p-0.5 hover:bg-white/10 rounded-lg transition-colors" aria-label="Dismiss">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        `;
        container.appendChild(el);

        if (duration > 0) setTimeout(() => {
          if (el.parentElement) {
            el.classList.replace('toast-enter', 'toast-exit');
            setTimeout(() => el.remove(), 200);
          }
        }, duration);
      }

      (window as any).showToast = showToast;
    </script>
    <script>
      import { api } from '../services/api';
      import { authStore, setUser } from '../stores/index';
      import { preloadData } from '../stores/dataStore';

      async function initAuth() {
        if (!sessionStorage.getItem('access_token')) return;
        
        const state = authStore.get();
        if (!state.user) {
          try {
            const user = await api.getCurrentUser();
            setUser(user);
            preloadData(); // Trigger data loading
          } catch (err) {
            console.error('Failed to load user session', err);
          }
        } else {
          preloadData();
        }
      }
      
      initAuth();
    </script>
  </body>
</html>
