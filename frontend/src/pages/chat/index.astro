---
// AI Chat page
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="AI Assistant - SynapseHR">
  <div class="h-[calc(100vh-8rem)] flex flex-col">
    <!-- Chat Container -->
    <div class="flex-1 flex gap-4 overflow-hidden">
      <!-- Conversation History Sidebar -->
      <div class="hidden lg:flex flex-col w-72 bg-dark-900 rounded-xl border border-dark-700">
        <div class="p-4 border-b border-dark-700">
          <button class="btn btn-primary w-full">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            New Conversation
          </button>
        </div>
        <div class="flex-1 overflow-y-auto p-2 space-y-1" id="conversationList">
          <div class="p-3 rounded-lg bg-primary-600/20 text-primary-400 cursor-pointer">
            <p class="text-sm font-medium truncate">Current Conversation</p>
            <p class="text-xs text-dark-500 mt-1">Just now</p>
          </div>
        </div>
      </div>

      <!-- Chat Area -->
      <div class="flex-1 flex flex-col bg-dark-900 rounded-xl border border-dark-700">
        <!-- Messages -->
        <div class="flex-1 overflow-y-auto p-4 space-y-4" id="chatMessages">
          <!-- Welcome message -->
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="bg-dark-800 rounded-xl p-4 max-w-2xl">
              <p class="text-dark-200">
                Hey there! 👋 I'm your AI HR assistant. I can help you with:
              </p>
              <ul class="mt-2 space-y-1 text-dark-300 text-sm">
                <li>📋 Answer HR policy questions</li>
                <li>🏖️ Check your leave balance</li>
                <li>📝 Apply for leave (just tell me the dates!)</li>
                <li>📄 Generate HR documents</li>
                <li>👥 Find employee information</li>
                <li>🏢 Explore departments</li>
              </ul>
              <p class="mt-3 text-dark-300 text-sm">
                Try saying: <span class="text-primary-400">"Apply for leave from 2026-07-10 to 2026-07-12"</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Input Area -->
        <div class="p-4 border-t border-dark-700">
          <form id="chatForm" class="flex gap-3">
            <input
              type="text"
              id="chatInput"
              class="input flex-1"
              placeholder="Ask HR anything or automate a task..."
              required
            />
            <button type="submit" class="btn btn-primary">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </button>
          </form>
          <div class="flex flex-wrap gap-2 mt-3" id="quickActions">
            <button type="button" data-msg="Show my leave balance" class="quick-action text-xs px-3 py-1.5 bg-dark-800 text-dark-300 rounded-full hover:bg-dark-700 cursor-pointer transition-colors">
              🏖️ Leave Balance
            </button>
            <button type="button" data-msg="Apply for leave" class="quick-action text-xs px-3 py-1.5 bg-dark-800 text-dark-300 rounded-full hover:bg-dark-700 cursor-pointer transition-colors">
              📝 Apply Leave
            </button>
            <button type="button" data-msg="Show my leave history" class="quick-action text-xs px-3 py-1.5 bg-dark-800 text-dark-300 rounded-full hover:bg-dark-700 cursor-pointer transition-colors">
              📜 Leave History
            </button>
            <button type="button" data-msg="How many employees are in the company?" class="quick-action text-xs px-3 py-1.5 bg-dark-800 text-dark-300 rounded-full hover:bg-dark-700 cursor-pointer transition-colors">
              👥 Headcount
            </button>
            <button type="button" data-msg="Show departments" class="quick-action text-xs px-3 py-1.5 bg-dark-800 text-dark-300 rounded-full hover:bg-dark-700 cursor-pointer transition-colors">
              🏢 Departments
            </button>
            <button type="button" data-msg="Generate experience letter" class="quick-action text-xs px-3 py-1.5 bg-dark-800 text-dark-300 rounded-full hover:bg-dark-700 cursor-pointer transition-colors">
              📄 Experience Letter
            </button>
            <button type="button" data-msg="What are the company holidays?" class="quick-action text-xs px-3 py-1.5 bg-dark-800 text-dark-300 rounded-full hover:bg-dark-700 cursor-pointer transition-colors">
              📅 Holidays
            </button>
            <button type="button" data-msg="Help" class="quick-action text-xs px-3 py-1.5 bg-dark-800 text-dark-300 rounded-full hover:bg-dark-700 cursor-pointer transition-colors">
              ❓ Help
            </button>
          </div>
        </div>
      </div>

      <!-- Right Panel - Workflow Info -->
      <div class="hidden xl:flex flex-col w-72 bg-dark-900 rounded-xl border border-dark-700 p-4">
        <h3 class="text-sm font-semibold text-dark-300 mb-3">AI Activity</h3>
        <div class="space-y-3" id="workflowTimeline">
          <div class="text-xs text-dark-500">
            No active workflow
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const API = (import.meta as any).env?.PUBLIC_API_URL || 'http://localhost:8000';
    const form = document.getElementById('chatForm') as HTMLFormElement;
    const input = document.getElementById('chatInput') as HTMLInputElement;
    const messages = document.getElementById('chatMessages') as HTMLDivElement;
    const workflowTimeline = document.getElementById('workflowTimeline') as HTMLDivElement;

    // Redirect to login if no token
    const token = localStorage.getItem('access_token');
    if (!token) {
      window.location.href = '/login';
    }

    let conversationId: string | null = null;
    let isProcessing = false;

    // New conversation button
    const newConvBtn = document.querySelector('button.btn-primary');
    if (newConvBtn) {
      newConvBtn.addEventListener('click', () => {
        conversationId = null;
        // Clear messages except welcome message
        const welcomeMsg = messages?.querySelector('.flex.gap-3');
        if (messages && welcomeMsg) {
          messages.innerHTML = '';
          messages.appendChild(welcomeMsg);
        }
        // Clear workflow timeline
        if (workflowTimeline) {
          workflowTimeline.innerHTML = '<div class="text-xs text-dark-500">No active workflow</div>';
        }
      });
    }

    // Load conversation history
    async function loadConversationHistory() {
      try {
        const response = await fetch(`${API}/api/v1/chat/history`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (response.ok) {
          const data = await response.json();
          if (data.success && data.data && data.data.length > 0) {
            const convList = document.getElementById('conversationList');
            if (convList) {
              convList.innerHTML = '';
              data.data.slice(0, 10).forEach((conv: any) => {
                const div = document.createElement('div');
                div.className = 'p-3 rounded-lg hover:bg-dark-800 cursor-pointer transition-colors';
                div.innerHTML = `
                  <p class="text-sm font-medium text-dark-200 truncate">${escapeHtml(conv.title || 'Conversation')}</p>
                  <p class="text-xs text-dark-500 mt-1">${new Date(conv.created_at).toLocaleDateString()}</p>
                `;
                div.addEventListener('click', () => loadConversation(conv.id));
                convList.appendChild(div);
              });
            }
          }
        }
      } catch (e) {
        console.error('Failed to load conversation history:', e);
      }
    }

    async function loadConversation(convId: string) {
      try {
        const response = await fetch(`${API}/api/v1/chat/${convId}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (response.ok) {
          const data = await response.json();
          if (data.success && data.data && data.data.messages) {
            conversationId = convId;
            // Clear current messages
            if (messages) {
              messages.innerHTML = '';
            }
            // Load messages
            data.data.messages.forEach((msg: any) => {
              if (msg.sender === 'user') {
                addUserMessage(msg.message);
              } else {
                addAIMessage(msg.message);
              }
            });
          }
        }
      } catch (e) {
        console.error('Failed to load conversation:', e);
      }
    }

    // Load history on page load
    loadConversationHistory();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message || isProcessing) return;

      isProcessing = true;
      addUserMessage(message);
      input.value = '';

      const loadingId = addLoadingMessage();

      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 120000);

        const response = await fetch(`${API}/api/v1/chat`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`,
          },
          body: JSON.stringify({ message, conversation_id: conversationId }),
          signal: controller.signal,
        });

        clearTimeout(timeoutId);
        removeLoadingMessage(loadingId);

        if (response.status === 401 || response.status === 403) {
          localStorage.removeItem('access_token');
          window.location.href = '/login';
          return;
        }

        if (!response.ok) {
          const errText = await response.text().catch(() => '');
          addAIMessage(`Sorry, the server returned an error (${response.status}). Please try again.`);
          return;
        }

        const data = await response.json();

        if (data.success && data.data) {
          if (data.data.conversation_id) {
            conversationId = data.data.conversation_id;
          }
          addAIMessage(data.data.response || 'I received your message but had no response.');
          
          // Show workflow steps in the activity panel
          if (data.data.workflow_steps && workflowTimeline) {
            workflowTimeline.innerHTML = '';
            data.data.workflow_steps.forEach((step: any) => {
              const div = document.createElement('div');
              div.className = 'p-2 bg-dark-800 rounded-lg text-xs';
              div.innerHTML = `
                <p class="text-primary-400 font-medium">${step.step?.replace(/_/g, ' ') || 'Step'}</p>
                <p class="text-dark-400 mt-1">${typeof step.result === 'object' ? JSON.stringify(step.result) : step.result}</p>
              `;
              workflowTimeline.appendChild(div);
            });
          }

          // If a leave was applied, set a flag for the leave page to refresh
          if (data.data.response && (
            data.data.response.includes('successfully applied') || 
            data.data.response.includes('leave request') ||
            data.data.response.includes('submitted')
          )) {
            localStorage.setItem('leave_applied', 'true');
          }

          // Refresh conversation history in sidebar
          loadConversationHistory();
        } else {
          addAIMessage(data.error?.message || 'Sorry, I encountered an error. Please try again.');
        }
      } catch (error: any) {
        removeLoadingMessage(loadingId);
        if (error?.name === 'AbortError') {
          addAIMessage('The request timed out. The AI service may be slow. Please try again.');
        } else {
          addAIMessage('Network error. Please check your connection and try again.');
        }
      } finally {
        isProcessing = false;
      }
    });

    // Quick action buttons
    document.querySelectorAll('#quickActions .quick-action').forEach(btn => {
      btn.addEventListener('click', () => {
        const msg = btn.getAttribute('data-msg');
        if (msg && input) {
          input.value = msg;
          form?.requestSubmit();
        }
      });
    });

    function addUserMessage(text: string) {
      const div = document.createElement('div');
      div.className = 'flex gap-3 justify-end';
      div.innerHTML = `
        <div class="bg-primary-600 rounded-xl p-4 max-w-2xl">
          <p class="text-white">${escapeHtml(text)}</p>
        </div>
        <div class="w-8 h-8 bg-dark-700 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-dark-300 text-sm font-medium">U</span>
        </div>
      `;
      messages?.appendChild(div);
      messages?.scrollTo(0, messages.scrollHeight);
    }

    function addAIMessage(text: string) {
      const div = document.createElement('div');
      div.className = 'flex gap-3';
      const rendered = simpleMarkdown(text);
      div.innerHTML = `
        <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="bg-dark-800 rounded-xl p-4 max-w-2xl">
          <div class="text-dark-200 whitespace-pre-wrap leading-relaxed">${rendered}</div>
        </div>
      `;
      messages?.appendChild(div);
      messages?.scrollTo(0, messages.scrollHeight);
    }

    function addLoadingMessage(): string {
      const id = 'loading-' + Date.now();
      const div = document.createElement('div');
      div.id = id;
      div.className = 'flex gap-3';
      div.innerHTML = `
        <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="bg-dark-800 rounded-xl p-4">
          <div class="flex space-x-2">
            <div class="w-2 h-2 bg-dark-400 rounded-full animate-bounce"></div>
            <div class="w-2 h-2 bg-dark-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
            <div class="w-2 h-2 bg-dark-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
          </div>
        </div>
      `;
      messages?.appendChild(div);
      messages?.scrollTo(0, messages.scrollHeight);
      return id;
    }

    function removeLoadingMessage(id: string) {
      document.getElementById(id)?.remove();
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function simpleMarkdown(text: string): string {
      let html = escapeHtml(text);
      html = html.replace(/\*\*(.+?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>');
      html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
      html = html.replace(/`(.+?)`/g, '<code class="bg-dark-700 px-1.5 py-0.5 rounded text-primary-300 text-sm">$1</code>');
      html = html.replace(/\n/g, '<br>');
      return html;
    }
  </script>
</DashboardLayout>
