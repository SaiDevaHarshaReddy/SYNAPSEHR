---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout title="Reset Password - SynapseHR">
  <div class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
    <!-- Background decorations -->
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 via-transparent to-purple-500/5" aria-hidden="true"></div>
    <div class="absolute top-1/3 right-1/3 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl" aria-hidden="true"></div>
    
    <div class="w-full max-w-md relative animate-fade-in-up">
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2.5 mb-6 group">
          <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-500/25 group-hover:shadow-indigo-500/40 transition-all duration-300">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-2xl font-bold text-white tracking-tight">Synapse<span class="text-indigo-400">HR</span></span>
        </a>
        <h1 class="text-2xl font-bold text-white">Reset Password</h1>
        <p class="mt-2 text-sm text-slate-400 leading-relaxed">Enter your new password below</p>
      </div>

      <div class="card-static p-8">
        <form id="reset-form" class="space-y-5">
          <input type="hidden" name="token" id="reset-token" />

          <div class="space-y-1.5">
            <label for="new_password" class="block text-sm font-medium text-slate-300">New Password</label>
            <input
              type="password"
              name="new_password"
              id="new_password"
              required
              minlength="8"
              class="input"
              placeholder="Enter new password"
              autocomplete="new-password"
            />
          </div>

          <div class="space-y-1.5">
            <label for="confirm_password" class="block text-sm font-medium text-slate-300">Confirm Password</label>
            <input
              type="password"
              name="confirm_password"
              id="confirm_password"
              required
              minlength="8"
              class="input"
              placeholder="Confirm new password"
              autocomplete="new-password"
            />
          </div>

          <p id="error-msg" class="text-sm text-red-400 hidden bg-red-500/10 border border-red-500/20 rounded-xl px-4 py-3" role="alert"></p>

          <button type="submit" class="btn-primary w-full py-3">
            Reset Password
          </button>
        </form>

        <div id="success-view" class="hidden text-center py-8 animate-fade-in">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <p class="text-lg font-semibold text-white mb-1">Password Reset</p>
          <p class="text-sm text-slate-400 mb-4">Your password has been reset successfully!</p>
          <a href="/login" class="btn-primary inline-flex items-center gap-2">
            Go to Login
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>

        <div class="mt-6 pt-6 border-t border-slate-800/50 text-center">
          <a href="/login" class="text-sm text-indigo-400 hover:text-indigo-300 font-medium transition-colors duration-200 inline-flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Login
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const token = params.get('token');
    if (token) {
      (document.getElementById('reset-token') as HTMLInputElement).value = token;
    }

    document.getElementById('reset-form')?.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      const errorEl = document.getElementById('error-msg')!;

      if (formData.get('new_password') !== formData.get('confirm_password')) {
        errorEl.textContent = 'Passwords do not match';
        errorEl.classList.remove('hidden');
        return;
      }

      errorEl.classList.add('hidden');

      try {
        const { api } = await import('../../services/api');
        await api.post('/api/v1/auth/reset-password', {
          token: formData.get('token'),
          new_password: formData.get('new_password'),
        });
        form.classList.add('hidden');
        document.getElementById('success-view')!.classList.remove('hidden');
      } catch (error: any) {
        errorEl.textContent = error?.response?.data?.error?.message || 'Failed to reset password';
        errorEl.classList.remove('hidden');
      }
    });
  </script>
</PublicLayout>
