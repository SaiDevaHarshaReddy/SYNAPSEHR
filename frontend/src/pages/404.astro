---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="Page Not Found">
  <div class="min-h-screen flex items-center justify-center bg-slate-950">
    <div class="text-center px-4">
      <div class="text-8xl font-bold text-indigo-500 mb-4">404</div>
      <h1 class="text-2xl font-bold text-white mb-2">Page Not Found</h1>
      <p class="text-slate-400 mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved. Please check the URL or go back to the dashboard.
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/dashboard" class="btn btn-primary">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          Go to Dashboard
        </a>
        <a href="/" class="btn btn-outline">
          Go Home
        </a>
      </div>
    </div>
  </div>
</PublicLayout>
