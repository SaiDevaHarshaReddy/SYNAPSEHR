---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Settings" description="Account and application settings">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-white">Settings</h1>
      <p class="mt-1 text-sm text-slate-400">Manage your account and application preferences</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Settings Navigation -->
      <div class="card p-4">
        <nav class="space-y-1">
          <button onclick="showSection('profile')" class="settings-nav-item w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-700 hover:text-white transition-colors flex items-center gap-3 active">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            Profile
          </button>
          <button onclick="showSection('notifications')" class="settings-nav-item w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-700 hover:text-white transition-colors flex items-center gap-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            Notifications
          </button>
          <button onclick="showSection('security')" class="settings-nav-item w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-700 hover:text-white transition-colors flex items-center gap-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            Security
          </button>
          <button onclick="showSection('appearance')" class="settings-nav-item w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-700 hover:text-white transition-colors flex items-center gap-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            Appearance
          </button>
        </nav>
      </div>

      <!-- Profile Section -->
      <div id="section-profile" class="lg:col-span-2 card p-6">
        <h2 class="text-lg font-semibold text-white mb-6">Profile Settings</h2>
        <form id="profile-form" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-1">First Name</label>
              <input type="text" id="profile-first-name" class="input w-full" placeholder="John">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-1">Last Name</label>
              <input type="text" id="profile-last-name" class="input w-full" placeholder="Doe">
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">Email</label>
            <input type="email" id="profile-email" class="input w-full" placeholder="john@company.com">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">Phone</label>
            <input type="tel" id="profile-phone" class="input w-full" placeholder="+1 234 567 890">
          </div>
          <div class="pt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </div>
        </form>
      </div>

      <!-- Notifications Section (hidden by default) -->
      <div id="section-notifications" class="lg:col-span-2 card p-6 hidden">
        <h2 class="text-lg font-semibold text-white mb-6">Notification Preferences</h2>
        <div class="space-y-4">
          <div class="flex items-center justify-between py-3 border-b border-slate-700">
            <div>
              <p class="text-sm font-medium text-white">Email Notifications</p>
              <p class="text-xs text-slate-400">Receive email for important updates</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" checked class="sr-only peer">
              <div class="w-11 h-6 bg-slate-600 peer-focus:ring-2 peer-focus:ring-indigo-500 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
            </label>
          </div>
          <div class="flex items-center justify-between py-3 border-b border-slate-700">
            <div>
              <p class="text-sm font-medium text-white">Leave Request Updates</p>
              <p class="text-xs text-slate-400">Get notified about leave status changes</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" checked class="sr-only peer">
              <div class="w-11 h-6 bg-slate-600 peer-focus:ring-2 peer-focus:ring-indigo-500 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
            </label>
          </div>
          <div class="flex items-center justify-between py-3 border-b border-slate-700">
            <div>
              <p class="text-sm font-medium text-white">Workflow Notifications</p>
              <p class="text-xs text-slate-400">Notifications for workflow approvals</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer">
              <div class="w-11 h-6 bg-slate-600 peer-focus:ring-2 peer-focus:ring-indigo-500 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
            </label>
          </div>
        </div>
      </div>

      <!-- Security Section (hidden by default) -->
      <div id="section-security" class="lg:col-span-2 card p-6 hidden">
        <h2 class="text-lg font-semibold text-white mb-6">Security Settings</h2>
        <form id="password-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">Current Password</label>
            <input type="password" class="input w-full" placeholder="Enter current password">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">New Password</label>
            <input type="password" class="input w-full" placeholder="Enter new password">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">Confirm New Password</label>
            <input type="password" class="input w-full" placeholder="Confirm new password">
          </div>
          <div class="pt-4">
            <button type="submit" class="btn btn-primary">Update Password</button>
          </div>
        </form>
      </div>

      <!-- Appearance Section (hidden by default) -->
      <div id="section-appearance" class="lg:col-span-2 card p-6 hidden">
        <h2 class="text-lg font-semibold text-white mb-6">Appearance</h2>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-3">Theme</label>
            <div class="grid grid-cols-3 gap-3">
              <button class="p-4 rounded-lg border-2 border-indigo-500 bg-slate-800 text-center">
                <div class="w-8 h-8 mx-auto mb-2 rounded bg-slate-900 border border-slate-600"></div>
                <span class="text-sm font-medium text-white">Dark</span>
              </button>
              <button class="p-4 rounded-lg border-2 border-slate-600 bg-slate-800 text-center opacity-50">
                <div class="w-8 h-8 mx-auto mb-2 rounded bg-white border border-slate-300"></div>
                <span class="text-sm font-medium text-slate-400">Light</span>
              </button>
              <button class="p-4 rounded-lg border-2 border-slate-600 bg-slate-800 text-center opacity-50">
                <div class="w-8 h-8 mx-auto mb-2 rounded bg-gradient-to-br from-slate-900 to-white border border-slate-600"></div>
                <span class="text-sm font-medium text-slate-400">System</span>
              </button>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">Language</label>
            <select class="input w-full">
              <option>English (US)</option>
              <option>English (UK)</option>
              <option>Hindi</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">Timezone</label>
            <select class="input w-full">
              <option>UTC</option>
              <option>America/New_York (EST)</option>
              <option>America/Chicago (CST)</option>
              <option>America/Denver (MST)</option>
              <option>America/Los_Angeles (PST)</option>
              <option>Asia/Kolkata (IST)</option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { authStore } from '../../stores/index';
    import { api } from '../../services/api';

    function showSection(section: string) {
      document.querySelectorAll('[id^="section-"]').forEach(el => el.classList.add('hidden'));
      document.getElementById(`section-${section}`)?.classList.remove('hidden');

      document.querySelectorAll('.settings-nav-item').forEach(btn => {
        btn.classList.remove('active', 'bg-slate-700', 'text-white');
        btn.classList.add('text-slate-300');
      });
      
      const activeBtn = document.querySelector(`[onclick="showSection('${section}')"]`);
      if (activeBtn) {
        activeBtn.classList.add('active', 'bg-slate-700', 'text-white');
        activeBtn.classList.remove('text-slate-300');
      }
    }
    (window as any).showSection = showSection;

    // Load initial Profile data
    authStore.subscribe((state: any) => {
      if (state.user) {
        const nameParts = (state.user.employee_name || '').split(' ');
        const fn = document.getElementById('profile-first-name') as HTMLInputElement;
        const ln = document.getElementById('profile-last-name') as HTMLInputElement;
        const email = document.getElementById('profile-email') as HTMLInputElement;
        if (fn) fn.value = nameParts[0] || '';
        if (ln) ln.value = nameParts.slice(1).join(' ') || '';
        if (email) email.value = state.user.email || '';
      }
    });

    // Profile Form
    document.getElementById('profile-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      if ((window as any).showToast) {
        (window as any).showToast('Profile updated successfully', 'success');
      }
    });

    // Notifications toggles
    const notifCheckboxes = document.querySelectorAll('#section-notifications input[type="checkbox"]');
    notifCheckboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        if ((window as any).showToast) {
          (window as any).showToast('Notification preferences saved', 'success');
        }
      });
    });

    // Security Form (Change Password)
    document.getElementById('password-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const target = e.target as HTMLFormElement;
      const inputs = target.querySelectorAll('input[type="password"]') as NodeListOf<HTMLInputElement>;
      
      const current = inputs[0].value;
      const newPass = inputs[1].value;
      const confirm = inputs[2].value;

      if (!current || !newPass || !confirm) {
        (window as any).showToast('Please fill all fields', 'error');
        return;
      }
      if (newPass !== confirm) {
        (window as any).showToast('New passwords do not match', 'error');
        return;
      }
      
      const btn = target.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = btn.textContent;
      btn.textContent = 'Updating...';
      btn.disabled = true;

      try {
        await api.changePassword(current, newPass);
        (window as any).showToast('Password updated successfully', 'success');
        target.reset();
      } catch (err: any) {
        const msg = err.response?.data?.message || 'Failed to update password';
        (window as any).showToast(msg, 'error');
      } finally {
        btn.textContent = originalText;
        btn.disabled = false;
      }
    });

    // Appearance
    const themeBtns = document.querySelectorAll('#section-appearance button');
    themeBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        themeBtns.forEach(b => {
          b.classList.remove('border-indigo-500');
          b.classList.add('border-slate-600', 'opacity-50');
        });
        btn.classList.add('border-indigo-500');
        btn.classList.remove('border-slate-600', 'opacity-50');
        
        const theme = ['dark', 'light', 'system'][index];
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        if ((window as any).showToast) {
          (window as any).showToast('Theme updated successfully', 'success');
        }
      });
    });

    const selects = document.querySelectorAll('#section-appearance select');
    selects.forEach(sel => {
      sel.addEventListener('change', () => {
        if ((window as any).showToast) {
          (window as any).showToast('Preference updated successfully', 'success');
        }
      });
    });
  </script>
</DashboardLayout>
