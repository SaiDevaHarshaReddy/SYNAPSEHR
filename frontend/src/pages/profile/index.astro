---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Profile" description="Your employee profile">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-white">My Profile</h1>
      <p class="mt-1 text-sm text-slate-400">View and manage your personal information</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Profile Card -->
      <div class="card p-6">
        <div class="text-center">
          <div id="profile-avatar" class="w-24 h-24 mx-auto rounded-full bg-indigo-500/10 flex items-center justify-center text-3xl font-bold text-indigo-400">
            --
          </div>
          <h2 id="profile-name" class="text-xl font-bold text-white mt-4">Loading...</h2>
          <p id="profile-designation" class="text-sm text-slate-400">-</p>
          <p id="profile-department" class="text-xs text-slate-500 mt-1">-</p>
          <div class="mt-4 flex justify-center gap-2">
            <span id="profile-status" class="badge badge-success">Active</span>
            <span id="profile-role" class="badge badge-info">-</span>
          </div>
        </div>
        <div class="mt-6 pt-6 border-t border-slate-700 space-y-3">
          <div class="flex items-center text-sm">
            <svg class="w-4 h-4 text-slate-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <span id="profile-email" class="text-slate-300">-</span>
          </div>
          <div class="flex items-center text-sm">
            <svg class="w-4 h-4 text-slate-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <span id="profile-phone" class="text-slate-300">-</span>
          </div>
          <div class="flex items-center text-sm">
            <svg class="w-4 h-4 text-slate-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span id="profile-joining" class="text-slate-300">Joined: -</span>
          </div>
        </div>
      </div>

      <!-- Details Card -->
      <div class="lg:col-span-2 card p-6">
        <h3 class="text-lg font-semibold text-white mb-6">Personal Information</h3>
        <div class="grid grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Employee Code</label>
            <p id="detail-code" class="text-sm text-white">-</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Date of Birth</label>
            <p id="detail-dob" class="text-sm text-white">-</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Gender</label>
            <p id="detail-gender" class="text-sm text-white">-</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Blood Group</label>
            <p id="detail-blood" class="text-sm text-white">-</p>
          </div>
          <div class="col-span-2">
            <label class="block text-xs font-medium text-slate-400 mb-1">Address</label>
            <p id="detail-address" class="text-sm text-white">-</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Employment Type</label>
            <p id="detail-employment" class="text-sm text-white">-</p>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">Work Location</label>
            <p id="detail-location" class="text-sm text-white">-</p>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-700">
          <h3 class="text-lg font-semibold text-white mb-4">Leave Balance</h3>
          <div id="leave-balance-grid" class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="p-3 rounded-lg bg-slate-700/30 text-center">
              <p class="text-2xl font-bold text-white">-</p>
              <p class="text-xs text-slate-400">Loading...</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { authStore } from '../../stores/index';

    function updateProfileUI(user: any) {
      if (!user) return;

      const name = `${user.first_name || ''} ${user.last_name || ''}`.trim() || 'User';
      document.getElementById('profile-avatar')!.textContent = name.split(' ').map((n: string) => n[0]).join('').toUpperCase().slice(0, 2);
      document.getElementById('profile-name')!.textContent = name;
      document.getElementById('profile-designation')!.textContent = user.designation || 'Employee';
      document.getElementById('profile-department')!.textContent = user.department || '';
      document.getElementById('profile-email')!.textContent = user.email || '-';
      document.getElementById('profile-phone')!.textContent = user.phone || '-';
      document.getElementById('profile-role')!.textContent = user.role || 'employee';
      document.getElementById('profile-joining')!.textContent = `Joined: ${user.joining_date || '-'}`;

      document.getElementById('detail-code')!.textContent = user.employee_code || '-';
      document.getElementById('detail-dob')!.textContent = user.date_of_birth || '-';
      document.getElementById('detail-gender')!.textContent = user.gender || '-';
      document.getElementById('detail-address')!.textContent = user.address || '-';
      document.getElementById('detail-employment')!.textContent = user.employment_type || 'Full-time';
      document.getElementById('detail-location')!.textContent = user.work_location || 'Office';
    }

    // Load from auth store
    const unsubscribe = authStore.subscribe((state: any) => {
      if (state.user) updateProfileUI(state.user);
    });

    // Initial load
    const initialState = authStore.get();
    if (initialState.user) updateProfileUI(initialState.user);
  </script>
</DashboardLayout>
