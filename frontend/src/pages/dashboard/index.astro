---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import WelcomeCard from "../../components/dashboard/WelcomeCard.astro";
import StatsGrid from "../../components/dashboard/StatsGrid.astro";
import QuickActions from "../../components/dashboard/QuickActions.astro";
import RecentActivity from "../../components/dashboard/RecentActivity.astro";
---

<DashboardLayout title="Dashboard - SynapseHR">
  <div class="space-y-6">
    <WelcomeCard />
    
    <div data-hr-only class="hidden">
      <StatsGrid />
    </div>
    
    <div id="quick-actions-row" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <QuickActions />
      <div data-hr-only class="hidden">
        <RecentActivity />
      </div>
    </div>

    <!-- AI HR Insights -->
    <div data-hr-only class="card p-6 border border-indigo-500/20 bg-gradient-to-br from-indigo-900/10 to-transparent relative overflow-hidden hidden">
      <div class="absolute -right-10 -top-10 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>
      <div class="flex items-center gap-2 mb-4">
        <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <h2 class="text-base font-semibold text-white">AI HR Insights</h2>
        <span class="badge badge-info text-[10px] py-0 px-1.5 ml-2">Beta</span>
      </div>
      <div id="dash-ai-insights" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="text-slate-500 text-sm py-2">Generating insights...</div>
      </div>
    </div>

    <!-- Analytics Charts -->
    <div data-hr-only class="grid grid-cols-1 lg:grid-cols-2 gap-6 hidden">
      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-4">
          Department Headcount
        </h2>
        <div class="h-64 relative">
          <canvas id="dash-dept-chart"></canvas>
          <div
            id="dash-dept-empty"
            class="hidden absolute inset-0 flex items-center justify-center text-slate-500 text-sm"
          >
            No department data available
          </div>
        </div>
      </div>
      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-4">
          Leave Distribution
        </h2>
        <div class="h-64 relative">
          <canvas id="dash-leave-chart"></canvas>
          <div
            id="dash-leave-empty"
            class="hidden absolute inset-0 flex items-center justify-center text-slate-500 text-sm"
          >
            No leave data available
          </div>
        </div>
      </div>
    </div>

    <!-- Employee by Employment Type + Recent Hires -->
    <div data-hr-only class="grid grid-cols-1 lg:grid-cols-2 gap-6 hidden">
      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-4">
          Employment Type Breakdown
        </h2>
        <div class="h-64 relative">
          <canvas id="dash-employment-chart"></canvas>
        </div>
      </div>
      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-4">Recent Hires</h2>
        <div id="dash-recent-hires" class="space-y-3">
          <div class="text-slate-500 text-sm py-4 text-center">Loading...</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import Chart from "chart.js/auto";
    import { api } from "../../services/api";
    import { 
      deptDistributionStore, 
      leaveAnalyticsStore, 
      employeesStore, 
      aiInsightsStore,
      dashboardMetricsStore,
      recruitmentStatsStore 
    } from "../../stores/dataStore";
    import { authStore } from "../../stores/index";

    const CHART_COLORS = {
      indigo: "#6366f1",
      amber: "#f59e0b",
      emerald: "#10b981",
      red: "#ef4444",
      blue: "#3b82f6",
      purple: "#a855f7",
      slate: "#64748b",
      cyan: "#06b6d4",
    };

    let dashDeptChartInstance: any = null;
    let dashLeaveChartInstance: any = null;
    let dashEmploymentChartInstance: any = null;
    let unsubscribes: any[] = [];

    async function fetchMissingDashboardData() {
      // If stores are empty, we fetch them individually (fallback)
      if (!deptDistributionStore.get() || deptDistributionStore.get().length === 0) {
        api.getDepartmentDistribution().then(d => { if(d) deptDistributionStore.set(d); }).catch(() => {});
      }
      if (!leaveAnalyticsStore.get()) {
        api.getLeaveAnalytics().then(d => { if(d) leaveAnalyticsStore.set(d); }).catch(() => {});
      }
      if (!employeesStore.get() || employeesStore.get().length === 0) {
        api.getEmployees({ page: 1, limit: 100 }).then(d => { if(d && (d as any).data) employeesStore.set((d as any).data); }).catch(() => {});
      }
      if (!aiInsightsStore.get()) {
        api.get("/api/v1/analytics/insights").then(d => { if(d && (d as any).data) aiInsightsStore.set((d as any).data); }).catch(() => {});
      }
    }

    function initDashboard() {
      // Clean up previous charts to prevent canvas re-use issues
      if (dashDeptChartInstance) { dashDeptChartInstance.destroy(); dashDeptChartInstance = null; }
      if (dashLeaveChartInstance) { dashLeaveChartInstance.destroy(); dashLeaveChartInstance = null; }
      if (dashEmploymentChartInstance) { dashEmploymentChartInstance.destroy(); dashEmploymentChartInstance = null; }
      
      unsubscribes.forEach(unsub => unsub());
      unsubscribes = [];

      unsubscribes.push(deptDistributionStore.subscribe(deptData => {
        if (deptData && deptData.length > 0) {
          document.getElementById("dash-dept-empty")?.classList.add("hidden");
          renderDeptChart(deptData);
        } else {
          document.getElementById("dash-dept-empty")?.classList.remove("hidden");
        }
      }));

      unsubscribes.push(leaveAnalyticsStore.subscribe(leaveData => {
        if (leaveData) {
          const hasData = Object.values(leaveData).some((v: any) => v > 0);
          if (hasData) {
            document.getElementById("dash-leave-empty")?.classList.add("hidden");
            renderLeaveChart(leaveData);
          } else {
            document.getElementById("dash-leave-empty")?.classList.remove("hidden");
          }
        } else {
          document.getElementById("dash-leave-empty")?.classList.remove("hidden");
        }
      }));

      unsubscribes.push(employeesStore.subscribe(employees => {
        if (employees && employees.length > 0) {
          renderEmploymentChart(employees);
          renderRecentHires(employees);
        }
      }));

      unsubscribes.push(aiInsightsStore.subscribe(insights => {
        const container = document.getElementById("dash-ai-insights");
        if (container) {
          if (insights && Array.isArray(insights)) {
            renderAIInsights(insights);
          } else {
            container.innerHTML = '<div class="text-slate-500 text-sm py-2">No insights available yet.</div>';
          }
        }
      }));

      fetchMissingDashboardData();
    }

    function renderAIInsights(insights: string[]) {
      const container = document.getElementById("dash-ai-insights");
      if (!container) return;
      if (!insights || !insights.length) {
        container.innerHTML = '<div class="text-slate-500 text-sm py-2">No insights available yet.</div>';
        return;
      }
      
      container.innerHTML = insights.map(insight => `
        <div class="flex items-start gap-3 p-3 bg-slate-800/40 rounded-xl border border-slate-700/50 hover:bg-slate-800/80 transition-colors">
          <div class="w-6 h-6 rounded-full bg-indigo-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <p class="text-sm text-slate-300 leading-relaxed">${insight}</p>
        </div>
      `).join("");
    }

    function renderDeptChart(
      data: Array<{ department: string; count: number }>,
    ) {
      const ctx = document.getElementById(
        "dash-dept-chart",
      ) as HTMLCanvasElement;
      if (!ctx) return;
      const colors = [
        CHART_COLORS.indigo,
        CHART_COLORS.blue,
        CHART_COLORS.purple,
        CHART_COLORS.amber,
        CHART_COLORS.emerald,
        CHART_COLORS.cyan,
      ];
      if (dashDeptChartInstance) {
        dashDeptChartInstance.data.labels = data.map((d) => d.department);
        dashDeptChartInstance.data.datasets[0].data = data.map((d) => d.count);
        dashDeptChartInstance.data.datasets[0].backgroundColor = data.map((_, i) => colors[i % colors.length] + "cc");
        dashDeptChartInstance.data.datasets[0].borderColor = data.map((_, i) => colors[i % colors.length]);
        dashDeptChartInstance.update();
        return;
      }
      dashDeptChartInstance = new Chart(ctx, {
        type: "bar",
        data: {
          labels: data.map((d) => d.department),
          datasets: [
            {
              label: "Employees",
              data: data.map((d) => d.count),
              backgroundColor: data.map(
                (_, i) => colors[i % colors.length] + "cc",
              ),
              borderColor: data.map((_, i) => colors[i % colors.length]),
              borderWidth: 1,
              borderRadius: 6,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { ticks: { color: "#94a3b8" }, grid: { display: false } },
            y: {
              ticks: { color: "#94a3b8", stepSize: 1 },
              grid: { color: "rgba(148,163,184,0.08)" },
              beginAtZero: true,
            },
          },
          plugins: { legend: { display: false } },
        },
      });
    }

    function renderLeaveChart(data: Record<string, number>) {
      const ctx = document.getElementById(
        "dash-leave-chart",
      ) as HTMLCanvasElement;
      if (!ctx) return;
      if (dashLeaveChartInstance) {
        dashLeaveChartInstance.data.datasets[0].data = [
          data.pending || 0,
          data.approved || 0,
          data.rejected || 0,
          data.cancelled || 0,
        ];
        dashLeaveChartInstance.update();
        return;
      }
      dashLeaveChartInstance = new Chart(ctx, {
        type: "doughnut",
        data: {
          labels: ["Pending", "Approved", "Rejected", "Cancelled"],
          datasets: [
            {
              data: [
                data.pending || 0,
                data.approved || 0,
                data.rejected || 0,
                data.cancelled || 0,
              ],
              backgroundColor: [
                CHART_COLORS.amber,
                CHART_COLORS.emerald,
                CHART_COLORS.red,
                CHART_COLORS.slate,
              ],
              borderWidth: 0,
              hoverOffset: 8,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: "65%",
          plugins: {
            legend: {
              position: "bottom",
              labels: { color: "#94a3b8", padding: 16, usePointStyle: true },
            },
          },
        },
      });
    }

    function renderEmploymentChart(employees: any[]) {
      const ctx = document.getElementById(
        "dash-employment-chart",
      ) as HTMLCanvasElement;
      if (!ctx) return;
      const typeCounts: Record<string, number> = {};
      employees.forEach((e) => {
        const t = e.employment_type || "full_time";
        typeCounts[t] = (typeCounts[t] || 0) + 1;
      });
      const labels = Object.keys(typeCounts).map((k) =>
        k.replace("_", " ").replace(/\b\w/g, (l: string) => l.toUpperCase()),
      );
      const values = Object.values(typeCounts);
      const colors = [
        CHART_COLORS.indigo,
        CHART_COLORS.cyan,
        CHART_COLORS.amber,
        CHART_COLORS.emerald,
      ];
      if (dashEmploymentChartInstance) {
        dashEmploymentChartInstance.data.labels = labels;
        dashEmploymentChartInstance.data.datasets[0].data = values;
        dashEmploymentChartInstance.data.datasets[0].backgroundColor = colors.slice(0, labels.length).map((c) => c + "cc");
        dashEmploymentChartInstance.update();
        return;
      }
      dashEmploymentChartInstance = new Chart(ctx, {
        type: "doughnut",
        data: {
          labels,
          datasets: [
            {
              data: values,
              backgroundColor: colors
                .slice(0, labels.length)
                .map((c) => c + "cc"),
              borderWidth: 0,
              hoverOffset: 8,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: "60%",
          plugins: {
            legend: {
              position: "bottom",
              labels: { color: "#94a3b8", padding: 12, usePointStyle: true },
            },
          },
        },
      });
    }

    function renderRecentHires(employees: any[]) {
      const container = document.getElementById("dash-recent-hires");
      if (!container) return;
      const sorted = [...employees].sort((a, b) => {
        const da = a.joining_date ? new Date(a.joining_date).getTime() : 0;
        const db = b.joining_date ? new Date(b.joining_date).getTime() : 0;
        return db - da;
      });
      const recent = sorted.slice(0, 5);
      if (recent.length === 0) {
        container.innerHTML =
          '<p class="text-slate-500 text-sm text-center py-4">No recent hires</p>';
        return;
      }
      const newHtml = recent
        .map(
          (emp: any) => `
        <div class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-800/40 transition-colors">
          <div class="w-9 h-9 rounded-full bg-indigo-500/10 flex items-center justify-center text-sm font-medium text-indigo-400 flex-shrink-0">
            ${emp.first_name?.[0] || ""}${emp.last_name?.[0] || ""}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-white truncate">${emp.first_name} ${emp.last_name}</p>
            <p class="text-xs text-slate-400">${emp.designation || "Employee"}</p>
          </div>
          <span class="text-xs text-slate-500 flex-shrink-0">${emp.joining_date ? new Date(emp.joining_date).toLocaleDateString() : "—"}</span>
        </div>
      `,
        )
        .join("");
        if (container.innerHTML !== newHtml) {
          container.innerHTML = newHtml;
        }
    }

    document.addEventListener('astro:page-load', () => {
      if (window.location.pathname === '/dashboard') {
        const user = authStore.get().user;
        const isHrOrAdmin = user && ['admin', 'administrator', 'hr'].includes(user.role);
        
        const hrElements = document.querySelectorAll('[data-hr-only]');
        hrElements.forEach(el => {
          if (isHrOrAdmin) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
        
        const quickActionsRow = document.getElementById('quick-actions-row');
        const quickActionsGrid = document.getElementById('quick-actions-grid');
        
        if (isHrOrAdmin) {
          if (quickActionsRow) quickActionsRow.classList.add('lg:grid-cols-2');
          if (quickActionsGrid) {
            quickActionsGrid.classList.remove('sm:grid-cols-4', 'lg:grid-cols-4');
            quickActionsGrid.classList.add('grid-cols-2');
          }
        } else {
          if (quickActionsRow) quickActionsRow.classList.remove('lg:grid-cols-2');
          if (quickActionsGrid) {
            quickActionsGrid.classList.remove('grid-cols-2');
            quickActionsGrid.classList.add('grid-cols-1', 'sm:grid-cols-2', 'md:grid-cols-4');
          }
        }
        
        if (isHrOrAdmin) {
          initDashboard();
        }
      }
    });

  </script>
</DashboardLayout>
