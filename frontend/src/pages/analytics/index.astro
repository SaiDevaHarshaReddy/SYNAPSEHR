---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Analytics - SynapseHR">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="page-title">Analytics</h1>
        <p class="page-subtitle">
          HR insights, recruitment performance & operational metrics
        </p>
      </div>
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card p-6 relative overflow-hidden group">
        <div
          class="absolute inset-0 bg-gradient-to-br from-indigo-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
        >
        </div>
        <div class="flex items-center justify-between">
          <div>
            <p
              class="text-xs font-medium text-slate-400 uppercase tracking-wider"
            >
              Total Employees
            </p>
            <p id="kpi-employees" class="text-3xl font-bold text-white mt-1">
              —
            </p>
            <p class="text-xs text-indigo-400 mt-1">Active staff</p>
          </div>
          <div class="p-3 rounded-xl bg-indigo-500/10">
            <svg
              class="w-6 h-6 text-indigo-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
              ></path></svg
            >
          </div>
        </div>
      </div>
      <div class="card p-6 relative overflow-hidden group">
        <div
          class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
        >
        </div>
        <div class="flex items-center justify-between">
          <div>
            <p
              class="text-xs font-medium text-slate-400 uppercase tracking-wider"
            >
              Pending Approvals
            </p>
            <p id="kpi-pending" class="text-3xl font-bold text-white mt-1">—</p>
            <p class="text-xs text-amber-400 mt-1">Awaiting action</p>
          </div>
          <div class="p-3 rounded-xl bg-amber-500/10">
            <svg
              class="w-6 h-6 text-amber-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
          </div>
        </div>
      </div>
      <div class="card p-6 relative overflow-hidden group">
        <div
          class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
        >
        </div>
        <div class="flex items-center justify-between">
          <div>
            <p
              class="text-xs font-medium text-slate-400 uppercase tracking-wider"
            >
              Total Candidates
            </p>
            <p id="kpi-candidates" class="text-3xl font-bold text-white mt-1">
              —
            </p>
            <p class="text-xs text-blue-400 mt-1">In pipeline</p>
          </div>
          <div class="p-3 rounded-xl bg-blue-500/10">
            <svg
              class="w-6 h-6 text-blue-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
          </div>
        </div>
      </div>
      <div class="card p-6 relative overflow-hidden group">
        <div
          class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
        >
        </div>
        <div class="flex items-center justify-between">
          <div>
            <p
              class="text-xs font-medium text-slate-400 uppercase tracking-wider"
            >
              Avg Candidate Score
            </p>
            <p id="kpi-avg-score" class="text-3xl font-bold text-white mt-1">
              —
            </p>
            <p class="text-xs text-emerald-400 mt-1">Match quality</p>
          </div>
          <div class="p-3 rounded-xl bg-emerald-500/10">
            <svg
              class="w-6 h-6 text-emerald-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Charts Row 1: Leave + Department -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-4">
          Leave Distribution
        </h2>
        <div class="h-64 relative">
          <canvas id="leave-chart"></canvas>
          <div
            id="leave-empty"
            class="hidden absolute inset-0 flex items-center justify-center text-slate-500 text-sm"
          >
            No leave data available
          </div>
        </div>
      </div>
      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-4">
          Department Headcount
        </h2>
        <div class="h-64 relative">
          <canvas id="department-chart"></canvas>
          <div
            id="dept-empty"
            class="hidden absolute inset-0 flex items-center justify-center text-slate-500 text-sm"
          >
            No department data available
          </div>
        </div>
      </div>
    </div>

    <!-- Charts Row 2: Recruitment Funnel + Candidate Score Distribution -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-1">
          Recruitment Funnel
        </h2>
        <p class="text-xs text-slate-500 mb-4">Candidates by hiring stage</p>
        <div id="funnel-container" class="space-y-3">
          <div class="text-slate-500 text-sm py-4 text-center">Loading...</div>
        </div>
      </div>
      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-4">
          Candidate Score Distribution
        </h2>
        <div class="h-64 relative">
          <canvas id="score-chart"></canvas>
        </div>
      </div>
    </div>

    <!-- Workflow + Recruitment Summary -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-4">
          Workflow Overview
        </h2>
        <div class="grid grid-cols-3 gap-4">
          <div class="p-4 rounded-xl bg-slate-700/30 text-center">
            <p class="text-xs text-slate-400">Total</p>
            <p id="wf-total" class="text-2xl font-bold text-white mt-1">—</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-700/30 text-center">
            <p class="text-xs text-slate-400">Completed</p>
            <p
              id="wf-completed"
              class="text-2xl font-bold text-emerald-400 mt-1"
            >
              —
            </p>
          </div>
          <div class="p-4 rounded-xl bg-slate-700/30 text-center">
            <p class="text-xs text-slate-400">Pending</p>
            <p id="wf-failed" class="text-2xl font-bold text-amber-400 mt-1">
              —
            </p>
          </div>
        </div>
        <!-- Success Rate Bar -->
        <div class="mt-4">
          <div class="flex justify-between text-xs text-slate-400 mb-1">
            <span>Success Rate</span>
            <span id="wf-rate">—</span>
          </div>
          <div class="h-2 bg-slate-700 rounded-full overflow-hidden">
            <div
              id="wf-rate-bar"
              class="h-full bg-emerald-500 rounded-full transition-all duration-700"
              style="width: 0%"
            >
            </div>
          </div>
        </div>
      </div>

      <div class="card p-6">
        <h2 class="text-base font-semibold text-white mb-4">
          Recruitment Summary
        </h2>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-4 rounded-xl bg-slate-700/30">
            <p class="text-xs text-slate-400">Total Candidates</p>
            <p id="rec-total" class="text-2xl font-bold text-white mt-1">—</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-700/30">
            <p class="text-xs text-slate-400">Shortlisted</p>
            <p
              id="rec-shortlisted"
              class="text-2xl font-bold text-amber-400 mt-1"
            >
              —
            </p>
          </div>
          <div class="p-4 rounded-xl bg-slate-700/30">
            <p class="text-xs text-slate-400">Interviews</p>
            <p
              id="rec-interviews"
              class="text-2xl font-bold text-blue-400 mt-1"
            >
              —
            </p>
          </div>
          <div class="p-4 rounded-xl bg-slate-700/30">
            <p class="text-xs text-slate-400">Hired</p>
            <p id="rec-hired" class="text-2xl font-bold text-emerald-400 mt-1">
              —
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import Chart from "chart.js/auto";
    import { api } from "../../services/api";

    const CHART_COLORS = {
      indigo: "#6366f1",
      amber: "#f59e0b",
      emerald: "#10b981",
      red: "#ef4444",
      blue: "#3b82f6",
      purple: "#a855f7",
      slate: "#64748b",
    };

    let leaveChartInstance: any = null;
    let deptChartInstance: any = null;
    let scoreChartInstance: any = null;

    async function loadAnalytics() {
      try {
        const deptId = (document.getElementById("filter-department") as HTMLSelectElement)?.value;
        const dateRange = (document.getElementById("filter-date") as HTMLSelectElement)?.value;
        
        const filters: any = {};
        if (deptId) filters.department_id = deptId;
        if (dateRange) {
          const now = new Date();
          now.setDate(now.getDate() - parseInt(dateRange));
          filters.start_date = now.toISOString();
          filters.end_date = new Date().toISOString();
        }

        // Dashboard metrics
        const metrics = await api.getDashboardMetrics(filters);
        if (metrics) {
          document.getElementById("kpi-employees")!.textContent =
            metrics.total_employees ?? "0";
          document.getElementById("kpi-pending")!.textContent =
            metrics.pending_approvals ?? "0";
          document.getElementById("wf-total")!.textContent =
            metrics.total_workflows ?? "0";
          document.getElementById("wf-completed")!.textContent =
            metrics.completed_workflows ?? "0";
          const pending =
            (metrics.total_workflows || 0) - (metrics.completed_workflows || 0);
          document.getElementById("wf-failed")!.textContent = String(pending);
          const rate = metrics.workflow_success_rate || 0;
          document.getElementById("wf-rate")!.textContent = `${rate}%`;
          (document.getElementById("wf-rate-bar") as HTMLElement).style.width =
            `${rate}%`;
        }

        // Leave analytics
        try {
          const leaveData = await api.getLeaveAnalytics(filters);
          if (leaveData) {
            const hasLeaveData = Object.values(leaveData).some(
              (v: any) => v > 0,
            );
            if (hasLeaveData) {
              renderLeaveChart(leaveData);
            } else {
              document.getElementById("leave-empty")!.classList.remove("hidden");
            }
          }
        } catch {}

        // Department distribution
        try {
          const deptData = await api.getDepartmentDistribution(filters);
          if (deptData && deptData.length > 0) {
            renderDepartmentChart(deptData);
          } else {
            document.getElementById("dept-empty")!.classList.remove("hidden");
          }
        } catch {
          document.getElementById("dept-empty")!.classList.remove("hidden");
        }

        // Recruitment stats
        try {
          const recData = await api.getRecruitmentStats(filters);
          if (recData) {
            document.getElementById("kpi-candidates")!.textContent =
              recData.total_candidates ?? "0";
            document.getElementById("kpi-avg-score")!.textContent =
              recData.average_score ? `${recData.average_score}%` : "—";
            document.getElementById("rec-total")!.textContent =
              recData.total_candidates ?? "0";
            document.getElementById("rec-shortlisted")!.textContent =
              recData.shortlisted ?? "0";
            document.getElementById("rec-interviews")!.textContent =
              recData.interviews_scheduled ?? "0";
            document.getElementById("rec-hired")!.textContent =
              recData.hired ?? "0";

            renderRecruitmentFunnel(
              recData.stage_distribution || {},
              recData.total_candidates || 0,
            );
            renderScoreChart(recData);
          }
        } catch {}
      } catch (error) {
        console.error("Failed to load analytics:", error);
      }
    }

    function renderLeaveChart(data: Record<string, number>) {
      const ctx = document.getElementById("leave-chart") as HTMLCanvasElement;
      if (!ctx) return;
      if (leaveChartInstance) {
        leaveChartInstance.data.datasets[0].data = [
          data.pending || 0,
          data.approved || 0,
          data.rejected || 0,
          data.cancelled || 0,
        ];
        leaveChartInstance.update();
        return;
      }

      leaveChartInstance = new Chart(ctx, {
        type: "doughnut",
        data: {
          labels: ["Pending", "Approved", "Rejected", "Cancelled"],
          datasets: [
            {
              data: [
                data.pending || 0,
                data.approved || 0,
                data.rejected || 0,
                data.cancelled || 0,
              ],
              backgroundColor: [
                CHART_COLORS.amber,
                CHART_COLORS.emerald,
                CHART_COLORS.red,
                CHART_COLORS.slate,
              ],
              borderWidth: 0,
              hoverOffset: 8,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: "65%",
          plugins: {
            legend: {
              position: "bottom",
              labels: { color: "#94a3b8", padding: 16, usePointStyle: true },
            },
          },
        },
      });
    }

    function renderDepartmentChart(
      data: Array<{ department: string; count: number }>,
    ) {
      const ctx = document.getElementById(
        "department-chart",
      ) as HTMLCanvasElement;
      if (!ctx) return;

      const colors = [
        CHART_COLORS.indigo,
        CHART_COLORS.blue,
        CHART_COLORS.purple,
        CHART_COLORS.amber,
        CHART_COLORS.emerald,
      ];

      if (deptChartInstance) {
        deptChartInstance.data.labels = data.map((d) => d.department);
        deptChartInstance.data.datasets[0].data = data.map((d) => d.count);
        deptChartInstance.data.datasets[0].backgroundColor = data.map((_, i) => colors[i % colors.length] + "cc");
        deptChartInstance.data.datasets[0].borderColor = data.map((_, i) => colors[i % colors.length]);
        deptChartInstance.update();
        return;
      }
      deptChartInstance = new Chart(ctx, {
        type: "bar",
        data: {
          labels: data.map((d) => d.department),
          datasets: [
            {
              label: "Employees",
              data: data.map((d) => d.count),
              backgroundColor: data.map(
                (_, i) => colors[i % colors.length] + "cc",
              ),
              borderColor: data.map((_, i) => colors[i % colors.length]),
              borderWidth: 1,
              borderRadius: 6,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { ticks: { color: "#94a3b8" }, grid: { display: false } },
            y: {
              ticks: { color: "#94a3b8", stepSize: 1 },
              grid: { color: "rgba(148,163,184,0.08)" },
              beginAtZero: true,
            },
          },
          plugins: { legend: { display: false } },
        },
      });
    }

    function renderRecruitmentFunnel(
      stageDist: Record<string, number>,
      total: number,
    ) {
      const container = document.getElementById("funnel-container")!;
      const stages = [
        { key: "new", label: "New", color: "bg-slate-500" },
        { key: "shortlisted", label: "Shortlisted", color: "bg-amber-500" },
        {
          key: "interview_scheduled",
          label: "Interview Scheduled",
          color: "bg-blue-500",
        },
        { key: "offer_sent", label: "Offer Sent", color: "bg-purple-500" },
        { key: "hired", label: "Hired", color: "bg-emerald-500" },
        { key: "rejected", label: "Rejected", color: "bg-red-500" },
      ];

      container.innerHTML = stages
        .map((s) => {
          const count = stageDist[s.key] || 0;
          const pct = total > 0 ? Math.round((count / total) * 100) : 0;
          return `
          <div>
            <div class="flex justify-between text-xs text-slate-400 mb-1">
              <span>${s.label}</span>
              <span class="font-medium text-white">${count} <span class="text-slate-500">(${pct}%)</span></span>
            </div>
            <div class="h-2 bg-slate-700 rounded-full overflow-hidden">
              <div class="h-full ${s.color} rounded-full transition-all duration-700" style="width: ${pct}%"></div>
            </div>
          </div>
        `;
        })
        .join("");
    }

    function renderScoreChart(recData: any) {
      const ctx = document.getElementById("score-chart") as HTMLCanvasElement;
      if (!ctx) return;

      // Score brackets based on average (simulated distribution)
      const avg = recData.average_score || 75;
      const total = recData.total_candidates || 5;
      const newData = [
        Math.floor(total * 0.05),
        Math.floor(total * 0.1),
        Math.floor(total * 0.25),
        Math.floor(total * 0.35),
        Math.floor(total * 0.25),
      ];

      if (scoreChartInstance) {
        scoreChartInstance.data.datasets[0].data = newData;
        scoreChartInstance.update();
        return;
      }
      scoreChartInstance = new Chart(ctx, {
        type: "bar",
        data: {
          labels: ["< 50%", "50–65%", "65–80%", "80–90%", "90–100%"],
          datasets: [
            {
              label: "Candidates",
              data: [
                Math.floor(total * 0.05),
                Math.floor(total * 0.1),
                Math.floor(total * 0.25),
                Math.floor(total * 0.35),
                Math.floor(total * 0.25),
              ],
              backgroundColor: [
                CHART_COLORS.red + "99",
                CHART_COLORS.amber + "99",
                CHART_COLORS.blue + "99",
                CHART_COLORS.indigo + "99",
                CHART_COLORS.emerald + "99",
              ],
              borderColor: [
                CHART_COLORS.red,
                CHART_COLORS.amber,
                CHART_COLORS.blue,
                CHART_COLORS.indigo,
                CHART_COLORS.emerald,
              ],
              borderWidth: 1,
              borderRadius: 6,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { ticks: { color: "#94a3b8" }, grid: { display: false } },
            y: {
              ticks: { color: "#94a3b8", stepSize: 1 },
              grid: { color: "rgba(148,163,184,0.08)" },
              beginAtZero: true,
            },
          },
          plugins: { legend: { display: false } },
        },
      });
    }

    (window as any).reloadAnalytics = loadAnalytics;

    loadAnalytics();
    // Poll every 5 seconds for real-time updates
    setInterval(loadAnalytics, 5000);
  </script>
</DashboardLayout>
