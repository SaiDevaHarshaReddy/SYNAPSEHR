---
// Leave page
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Leave Management - SynapseHR">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="page-title">Leave Management</h1>
        <p class="page-subtitle">Manage leave requests and balances</p>
      </div>
      <button id="requestLeaveBtn" class="btn btn-primary">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        Request Leave
      </button>
    </div>

    <!-- Leave Balance Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card p-5">
        <p class="text-sm text-slate-400">Casual Leave</p>
        <p class="text-2xl font-bold text-white mt-1" id="balance-casual">-</p>
        <p class="text-xs text-slate-500">days available</p>
      </div>
      <div class="card p-5">
        <p class="text-sm text-slate-400">Sick Leave</p>
        <p class="text-2xl font-bold text-white mt-1" id="balance-sick">-</p>
        <p class="text-xs text-slate-500">days available</p>
      </div>
      <div class="card p-5">
        <p class="text-sm text-slate-400">Annual Leave</p>
        <p class="text-2xl font-bold text-white mt-1" id="balance-annual">-</p>
        <p class="text-xs text-slate-500">days available</p>
      </div>
      <div class="card p-5">
        <p class="text-sm text-slate-400">Used This Year</p>
        <p class="text-2xl font-bold text-white mt-1" id="balance-used">-</p>
        <p class="text-xs text-slate-500">days</p>
      </div>
    </div>

    <!-- Leave History -->
    <div class="card p-6">
      <h2 class="text-lg font-semibold text-white mb-4">Leave History</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Employee</th>
            <th>Type</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th>Reason</th>
            <th id="actions-header" class="hidden">Actions</th>
          </tr>
        </thead>
        <tbody id="leaveHistoryTable">
          <tr>
            <td colspan="7" class="text-center py-8 text-slate-400">
              Loading leave requests...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Leave Request Modal -->
  <div id="leaveModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="card w-full max-w-md mx-4 p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Request Leave</h3>
      <form id="leaveForm" class="space-y-4">
        <div>
          <label class="form-label">Leave Type</label>
          <select id="leaveType" class="input" required>
            <option value="">Select type</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="form-label">Start Date</label>
            <input type="date" id="startDate" class="input" required />
          </div>
          <div>
            <label class="form-label">End Date</label>
            <input type="date" id="endDate" class="input" required />
          </div>
        </div>
        <div>
          <label class="form-label">Reason</label>
          <textarea id="reason" class="input" rows="3" placeholder="Optional reason..."></textarea>
        </div>
        <div class="flex gap-3 justify-end mt-6">
          <button type="button" id="cancelModal" class="btn btn-secondary">Cancel</button>
          <button type="submit" class="btn btn-primary">Submit Request</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script>
  import { api } from '../../services/api';
  import { leaveRequestsStore } from '../../stores/dataStore';

  let leaveTypes: any[] = [];
  let user: any = null;
  let isManager = false;

  let modal: HTMLDivElement | null;
  let requestBtn: HTMLButtonElement | null;
  let cancelBtn: HTMLButtonElement | null;
  let leaveForm: HTMLFormElement | null;
  let leaveTypeSelect: HTMLSelectElement | null;
  let leaveHistoryTable: HTMLTableSectionElement | null;
  let refreshInterval: number | undefined;

  function bindDOM() {
    modal = document.getElementById('leaveModal') as HTMLDivElement;
    requestBtn = document.getElementById('requestLeaveBtn') as HTMLButtonElement;
    cancelBtn = document.getElementById('cancelModal') as HTMLButtonElement;
    leaveForm = document.getElementById('leaveForm') as HTMLFormElement;
    leaveTypeSelect = document.getElementById('leaveType') as HTMLSelectElement;
    leaveHistoryTable = document.getElementById('leaveHistoryTable') as HTMLTableSectionElement;

    requestBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));
    cancelBtn?.addEventListener('click', () => modal?.classList.add('hidden'));

    leaveForm?.addEventListener('submit', handleLeaveSubmit);
  }

  async function handleLeaveSubmit(e: Event) {
    e.preventDefault();
    const typeId = (document.getElementById('leaveType') as HTMLSelectElement).value;
    const startDate = (document.getElementById('startDate') as HTMLInputElement).value;
    const endDate = (document.getElementById('endDate') as HTMLInputElement).value;
    const reason = (document.getElementById('reason') as HTMLTextAreaElement).value;

    try {
      const newReq = await api.createLeaveRequest({
        leave_type_id: typeId,
        start_date: startDate,
        end_date: endDate,
        reason: reason,
      });
      modal?.classList.add('hidden');
      leaveForm?.reset();
      
      // Update store
      leaveRequestsStore.set([newReq, ...leaveRequestsStore.get()]);
      updateBalances();
    } catch (err) {
      console.error('Failed to create leave request:', err);
      alert('Error creating leave request. Please check inputs and balance.');
    }
  }

  async function initLeavePage() {
    try {
      if(!user) {
        user = await api.getCurrentUser();
        isManager = user && ['admin', 'hr', 'administrator'].includes(user.role);
      }
      
      if (isManager) {
        document.getElementById('actions-header')?.classList.remove('hidden');
      }

      leaveTypes = await api.getLeaveTypes().catch(() => []);
      populateLeaveTypes();
      
      leaveRequestsStore.subscribe(history => {
        renderHistory(history);
      });

      updateBalances();
    } catch (error) {
      console.error('Failed to initialize leave page:', error);
      populateLeaveTypes(true);
    }
  }
  
  async function updateBalances() {
      const balances = await api.getLeaveBalance().catch(() => []);
      let usedTotal = 0;
      
      const bc = document.getElementById('balance-casual');
      if(bc) bc.textContent = '0';
      const bs = document.getElementById('balance-sick');
      if(bs) bs.textContent = '0';
      const ba = document.getElementById('balance-annual');
      if(ba) ba.textContent = '0';
      const bu = document.getElementById('balance-used');
      if(bu) bu.textContent = '0';

      if (balances && balances.length > 0) {
        balances.forEach(b => {
          const typeName = (b.leave_type_name || '').toLowerCase();
          const availableId = typeName.includes('casual') ? 'balance-casual' :
                              typeName.includes('sick') ? 'balance-sick' :
                              typeName.includes('annual') ? 'balance-annual' : null;
          if (availableId) {
            const el = document.getElementById(availableId);
            if (el) el.textContent = b.available_days.toString();
          }
          usedTotal += b.used_days || 0;
        });
      }
      
      const usedEl = document.getElementById('balance-used');
      if (usedEl) usedEl.textContent = usedTotal.toString();
  }

  function populateLeaveTypes(fallback = false) {
    if (leaveTypeSelect) {
      leaveTypeSelect.innerHTML = '<option value="">Select type</option>';
      const types = (!fallback && leaveTypes.length > 0) ? leaveTypes : [
        { id: 'casual', name: 'Casual Leave' },
        { id: 'sick', name: 'Sick Leave' },
        { id: 'annual', name: 'Annual Leave' },
        { id: 'maternity', name: 'Maternity Leave' },
        { id: 'paternity', name: 'Paternity Leave' },
        { id: 'unpaid', name: 'Unpaid Leave' },
      ];
      types.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.id;
        opt.textContent = t.name;
        leaveTypeSelect!.appendChild(opt);
      });
    }
  }

  function renderHistory(history: any[]) {
    if (!leaveHistoryTable) return;
    
    if (!history || history.length === 0) {
      leaveHistoryTable.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-slate-400">No leave requests found</td></tr>`;
      return;
    }
    
    leaveHistoryTable.innerHTML = '';
    history.forEach(req => {
      const tr = document.createElement('tr');
      if (req.is_read === false && isManager) {
        tr.classList.add('bg-indigo-500/10');
      }
      
      const statusStr = (req.status || 'pending').toLowerCase();
      let badgeClass = 'badge-warning'; 
      if (statusStr === 'approved' || statusStr === 'completed') badgeClass = 'badge-success';
      else if (statusStr === 'rejected' || statusStr === 'failed') badgeClass = 'badge-error';
      
      let statusHtml = ``;
      if (isManager) {
          statusHtml = `
          <select class="input py-1 px-2 text-xs" onchange="window.updateLeaveStatus('${req.id}', this.value)">
            <option value="pending" ${statusStr === 'pending' ? 'selected' : ''}>Pending</option>
            <option value="approved" ${statusStr === 'approved' ? 'selected' : ''}>Approved</option>
            <option value="rejected" ${statusStr === 'rejected' ? 'selected' : ''}>Rejected</option>
          </select>
          `;
      } else {
          statusHtml = `<span class="badge ${badgeClass}">${req.status}</span>`;
      }
      
      let actionsHtml = ``;
      if (isManager) {
        actionsHtml = `
          <td class="flex gap-2">
            ${req.is_read === false ? `<button onclick="window.markLeaveRead('${req.id}')" class="btn btn-secondary py-1 px-2 text-xs">Mark Read</button>` : `<span class="text-xs text-slate-500">Read</span>`}
          </td>
        `;
      } else {
        actionsHtml = `<td class="hidden"></td>`;
      }
      
      tr.innerHTML = `
        <td class="font-medium text-white">${req.employee_name || 'Me'}</td>
        <td class="font-medium text-white">${req.leave_type?.name || req.leave_type_name || 'Leave'}</td>
        <td class="text-slate-300">${req.start_date}</td>
        <td class="text-slate-300">${req.end_date}</td>
        <td>${statusHtml}</td>
        <td class="text-slate-400 text-sm">${req.reason || '-'}</td>
        ${actionsHtml}
      `;
      leaveHistoryTable!.appendChild(tr);
    });
  }

  (window as any).updateLeaveStatus = async function(requestId: string, status: string) {
    try {
      const updated = await api.approveLeave(requestId, status);
      const items = leaveRequestsStore.get().map(r => r.id === requestId ? updated : r);
      leaveRequestsStore.set(items);
    } catch (err) {
      console.error('Failed to update status', err);
      alert('Failed to update leave status. Please try again.');
    }
  };

  (window as any).markLeaveRead = async function(requestId: string) {
    try {
      const updated = await api.markLeaveAsRead(requestId);
      const items = leaveRequestsStore.get().map(r => r.id === requestId ? updated : r);
      leaveRequestsStore.set(items);
    } catch (err) {
      console.error('Failed to mark as read', err);
    }
  };

  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname.startsWith('/leave')) {
      bindDOM();
      initLeavePage();
      
      if (leaveRequestsStore.get().length === 0) {
        api.getLeaveHistory().then(res => {
          leaveRequestsStore.set((res as any) || []);
        }).catch(() => {});
      }

      if (sessionStorage.getItem('leave_applied') === 'true') {
        sessionStorage.removeItem('leave_applied');
        api.getLeaveHistory().then(res => {
          leaveRequestsStore.set((res as any) || []);
        }).catch(() => {});
      }

      clearInterval(refreshInterval);
      refreshInterval = window.setInterval(() => {
        api.getLeaveHistory().then(res => {
          leaveRequestsStore.set((res as any) || []);
        }).catch(() => {});
      }, 30000);
    } else {
      clearInterval(refreshInterval);
    }
  });
</script>
