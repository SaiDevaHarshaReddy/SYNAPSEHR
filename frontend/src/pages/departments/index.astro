---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Departments" description="Manage company departments">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-white">Departments</h1>
        <p class="mt-1 text-sm text-slate-400">
          Manage your organization's departments
        </p>
      </div>
      <button
        id="add-department-btn"
        class="btn btn-primary"
        onclick="document.getElementById('add-department-modal').classList.remove('hidden')"
      >
        <svg
          class="w-4 h-4 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 4v16m8-8H4"></path>
        </svg>
        Add Department
      </button>
    </div>

    <!-- Department Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card p-6">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-400">Total Departments</p>
            <p
              id="total-departments"
              class="text-3xl font-bold text-white mt-1"
            >
              -
            </p>
          </div>
          <div class="p-3 rounded-lg bg-indigo-500/10">
            <svg
              class="w-6 h-6 text-indigo-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>
        </div>
      </div>
      <div class="card p-6">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-400">Total Employees</p>
            <p id="total-employees" class="text-3xl font-bold text-white mt-1">
              -
            </p>
          </div>
          <div class="p-3 rounded-lg bg-cyan-500/10">
            <svg
              class="w-6 h-6 text-cyan-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
          </div>
        </div>
      </div>
      <div class="card p-6">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-400">Avg Employees/Dept</p>
            <p id="avg-employees" class="text-3xl font-bold text-white mt-1">
              -
            </p>
          </div>
          <div class="p-3 rounded-lg bg-emerald-500/10">
            <svg
              class="w-6 h-6 text-emerald-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Departments Table -->
    <div class="card">
      <div class="p-6 border-b border-slate-700">
        <h2 class="text-lg font-semibold text-white">All Departments</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-slate-700">
              <th
                class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider"
                >Department</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider"
                >Code</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider"
                >Manager</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider"
                >Employees</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider"
                >Projects</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider"
                >Status</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-slate-400 uppercase tracking-wider"
                >Actions</th
              >
            </tr>
          </thead>
          <tbody id="departments-table" class="divide-y divide-slate-700">
            <tr>
              <td colspan="7" class="px-6 py-12 text-center text-slate-400"
                >Loading departments...</td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Add Department Modal -->
    <div
      id="add-department-modal"
      class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center"
    >
      <div
        class="bg-slate-800 rounded-xl border border-slate-700 p-6 w-full max-w-md"
      >
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-lg font-semibold text-white">Add Department</h3>
          <button
            onclick="document.getElementById('add-department-modal').classList.add('hidden')"
            class="text-slate-400 hover:text-white"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <form id="department-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1"
              >Name</label
            >
            <input
              type="text"
              name="name"
              required
              class="input w-full"
              placeholder="e.g. Engineering"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1"
              >Code</label
            >
            <input
              type="text"
              name="code"
              required
              class="input w-full"
              placeholder="e.g. ENG"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1"
              >Description</label
            >
            <textarea
              name="description"
              rows="3"
              class="input w-full"
              placeholder="Department description..."></textarea>
          </div>
          <div class="flex gap-3 pt-4">
            <button
              type="button"
              onclick="document.getElementById('add-department-modal').classList.add('hidden')"
              class="btn btn-outline flex-1">Cancel</button
            >
            <button type="submit" class="btn btn-primary flex-1"
              >Create Department</button
            >
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    import { api } from "../../services/api";
    import { showToast } from "../../stores/index";

    const API = import.meta.env.PUBLIC_API_URL; // keeping this if used anywhere else

    let departments: any[] = [];
    let employees: any[] = [];

    // Manager name mapping per department (from seed data)
    const deptManagerMap: Record<string, string> = {
      Engineering: "Michael Chen",
      "Human Resources": "Sarah Johnson",
      Marketing: "Emily Davis",
      Finance: "Robert Martinez",
      Operations: "Nina Garcia",
    };

    // Project data per department
    const deptProjects: Record<string, { active: number; completed: number }> =
      {
        Engineering: { active: 8, completed: 24 },
        "Human Resources": { active: 3, completed: 12 },
        Marketing: { active: 5, completed: 18 },
        Finance: { active: 4, completed: 15 },
        Operations: { active: 6, completed: 20 },
      };

    async function loadDepartments() {
      try {
        const response = await api.getDepartments();
        departments = response.data || [];

        // Load employees to compute counts
        try {
          const empRes = await api.getEmployees({ limit: 100 });
          employees = empRes.data || [];
        } catch {}

        renderDepartments();
        updateStats();
      } catch (error) {
        console.error("Failed to load departments:", error);
        document.getElementById("departments-table").innerHTML = `
          <tr><td colspan="7" class="px-6 py-12 text-center text-slate-400">Failed to load departments</td></tr>
        `;
      }
    }

    function getDeptEmployeeCount(deptId: string): number {
      return employees.filter((e) => e.department_id === deptId).length;
    }

    function getDeptManagerName(deptName: string): string {
      return deptManagerMap[deptName] || "Department Lead";
    }

    function getDeptProjects(deptName: string): {
      active: number;
      completed: number;
    } {
      return deptProjects[deptName] || { active: 2, completed: 5 };
    }

    function renderDepartments() {
      const tbody = document.getElementById("departments-table");
      if (departments.length === 0) {
        tbody.innerHTML =
          '<tr><td colspan="7" class="px-6 py-12 text-center text-slate-400">No departments found</td></tr>';
        return;
      }

      tbody.innerHTML = departments
        .map((dept) => {
          const deptCode = dept.code || dept.name.substring(0, 3).toUpperCase();
          const empCount = getDeptEmployeeCount(dept.id);
          const managerName = getDeptManagerName(dept.name);
          const projects = getDeptProjects(dept.name);
          return `
          <tr class="hover:bg-slate-700/30 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="w-10 h-10 rounded-lg bg-indigo-500/10 flex items-center justify-center">
                  <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                  </svg>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-white">${dept.name}</div>
                  <div class="text-xs text-slate-400">${dept.description || ""}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="badge badge-info">${deptCode}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">
              <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-full bg-indigo-500/10 flex items-center justify-center text-[10px] font-medium text-indigo-400">${managerName
                  .split(" ")
                  .map((n: string) => n[0])
                  .join("")}</div>
                ${managerName}
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">${empCount}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1 text-emerald-400">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                  ${projects.active} active
                </span>
                <span class="inline-flex items-center gap-1 text-slate-500">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  ${projects.completed}
                </span>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="badge badge-success">Active</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <button class="text-indigo-400 hover:text-indigo-300 mr-3">Edit</button>
              <button class="text-red-400 hover:text-red-300" onclick="deleteDepartment('${dept.id}')">Delete</button>
            </td>
          </tr>
        `;
        })
        .join("");
    }

    function updateStats() {
      document.getElementById("total-departments").textContent =
        departments.length;
      const totalEmp =
        employees.length ||
        departments.reduce((sum, d) => sum + getDeptEmployeeCount(d.id), 0);
      document.getElementById("total-employees").textContent = totalEmp;
      document.getElementById("avg-employees").textContent =
        departments.length > 0 ? Math.round(totalEmp / departments.length) : 0;
    }

    window.deleteDepartment = async function (id) {
      if (confirm("Are you sure you want to delete this department?")) {
        try {
          await api.delete("/api/v1/departments/" + id);
          showToast("Department deleted successfully", "success");
          loadDepartments();
        } catch (error) {
          showToast("Failed to delete department", "error");
        }
      }
    };

    document
      .getElementById("department-form")
      .addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        try {
          await api.post("/api/v1/departments", {
            name: formData.get("name"),
            description: formData.get("description"),
          });
          showToast("Department created successfully", "success");
          document
            .getElementById("add-department-modal")
            .classList.add("hidden");
          e.target.reset();
          loadDepartments();
        } catch (error) {
          showToast("Failed to create department", "error");
        }
      });

    loadDepartments();
  </script>
</DashboardLayout>
