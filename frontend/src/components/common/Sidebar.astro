---
const navItems = [
  { label: 'Dashboard', href: '/dashboard', icon: 'home' },
  { label: 'AI Assistant', href: '/chat', icon: 'ai' },
  { label: 'Recruitment', href: '/recruitment', icon: 'recruit' },
  { label: 'Employees', href: '/employees', icon: 'users' },
  { label: 'Departments', href: '/departments', icon: 'building' },
  { label: 'Leave', href: '/leave', icon: 'calendar' },
  { label: 'Documents', href: '/documents', icon: 'document' },
  { label: 'Knowledge Base', href: '/knowledge', icon: 'database' },
  { label: 'Analytics', href: '/analytics', icon: 'chart' },
  { label: 'Notifications', href: '/notifications', icon: 'bell' },
  { label: 'Settings', href: '/settings', icon: 'settings' },
  { label: 'Admin', href: '/admin', icon: 'cog' },
];

const currentPath = Astro.url.pathname;
---

<aside class="hidden lg:flex flex-col w-64 bg-slate-900/95 backdrop-blur-xl border-r border-slate-800/80" role="navigation" aria-label="Main navigation">
  <!-- Logo -->
  <div class="h-16 flex items-center px-5 border-b border-slate-800/80">
    <a href="/dashboard" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/20 group-hover:shadow-indigo-500/30 transition-all duration-300">
        <svg class="w-4.5 h-4.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <span class="text-lg font-bold text-white tracking-tight">Synapse<span class="text-indigo-400">HR</span></span>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-4 space-y-0.5 overflow-y-auto scrollbar-hidden">
    {navItems.map((item) => {
      const isActive = currentPath.startsWith(item.href);
      return (
        <a
          href={item.href}
          data-nav-item={item.label.toLowerCase()}
          class:list={[
            'items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 relative group',
            item.label.toLowerCase() === 'admin' ? 'hidden' : 'flex',
            isActive
              ? 'bg-indigo-500/10 text-indigo-400'
              : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60',
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          {isActive && (
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-0.5 h-5 bg-indigo-500 rounded-r-full" aria-hidden="true"></div>
          )}
          <svg class:list={['w-5 h-5 transition-colors duration-200', isActive ? 'text-indigo-400' : 'text-slate-500 group-hover:text-slate-300']} fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            {item.icon === 'home' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />}
            {item.icon === 'ai' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />}
            {item.icon === 'users' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />}
            {item.icon === 'building' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />}
            {item.icon === 'calendar' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />}
            {item.icon === 'document' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />}
            {item.icon === 'database' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c-2.218 0-4.382.586-6 1.5v3c1.618-.914 3.782-1.5 6-1.5s4.382.586 6 1.5v-3c-1.618-.914-3.782-1.5-6-1.5z" />}
            {item.icon === 'chart' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />}
            {item.icon === 'bell' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />}
            {item.icon === 'recruit' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />}
            {item.icon === 'settings' && <><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></>}
            {item.icon === 'cog' && <><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></>}
          </svg>
          <span class:list={['transition-colors duration-200', isActive ? 'text-indigo-400 font-semibold' : '']}>{item.label}</span>
        </a>
      );
    })}
  </nav>

  <!-- User section removed -->
</aside>

<script>
  import { authStore } from '../../stores/index';

  function updateUser(user: any) {
    if (!user) return;
    
    // Unhide Admin tab if admin
    const adminLink = document.querySelector('[data-nav-item="admin"]') as HTMLElement;
    if (adminLink) {
      if (user.role === 'admin') {
        adminLink.classList.remove('hidden');
        adminLink.classList.add('flex');
      } else {
        adminLink.classList.add('hidden');
        adminLink.classList.remove('flex');
      }
    }
  }

  authStore.subscribe((state: any) => updateUser(state.user));
  const initialState = authStore.get();
  if (initialState.user) updateUser(initialState.user);
</script>
