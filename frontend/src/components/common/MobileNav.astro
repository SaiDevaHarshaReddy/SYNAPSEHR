---
const navItems = [
  { label: 'Home', href: '/dashboard', icon: 'home' },
  { label: 'Chat', href: '/chat', icon: 'ai' },
  { label: 'Recruit', href: '/recruitment', icon: 'recruit' },
  { label: 'Leave', href: '/leave', icon: 'calendar' },
  { label: 'Analytics', href: '/analytics', icon: 'more' },
];

const currentPath = Astro.url.pathname;
---

<!-- Mobile Bottom Nav -->
<nav class="lg:hidden fixed bottom-0 left-0 right-0 bg-slate-900/95 backdrop-blur-xl border-t border-slate-800/80 z-40 safe-area-bottom" role="navigation" aria-label="Mobile navigation">
  <div class="flex items-center justify-around py-1.5 px-2">
    {navItems.map((item) => {
      const isActive = currentPath.startsWith(item.href);
      return (
        <a
          href={item.href}
          class:list={[
            'flex flex-col items-center gap-0.5 px-3 py-2 rounded-xl transition-all duration-200 min-w-[56px]',
            isActive
              ? 'text-indigo-400'
              : 'text-slate-500 hover:text-slate-300',
          ]}
          aria-current={isActive ? 'page' : undefined}
        >
          <div class:list={[
            'p-1.5 rounded-xl transition-all duration-200',
            isActive ? 'bg-indigo-500/10' : '',
          ]}>
            {item.icon === 'home' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            )}
            {item.icon === 'ai' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            )}
            {item.icon === 'calendar' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            )}
            {item.icon === 'document' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
            {item.icon === 'recruit' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            )}
            {item.icon === 'more' && (
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            )}
          </div>
          <span class:list={[
            'text-[10px] font-medium transition-colors duration-200',
            isActive ? 'text-indigo-400' : '',
          ]}>{item.label}</span>
          {isActive && (
            <div class="absolute top-0 w-6 h-0.5 bg-indigo-500 rounded-b-full" aria-hidden="true"></div>
          )}
        </a>
      );
    })}
  </div>
</nav>

<!-- Spacer for mobile nav -->
<div class="lg:hidden h-16"></div>

<script>
  import { showToast } from '../../stores/index';
  (window as any).showToast = showToast;
</script>

<style>
  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
</style>
