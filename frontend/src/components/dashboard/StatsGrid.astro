---

---

<div
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"
  id="stats-grid"
  role="list"
  aria-label="Dashboard statistics"
>
  <!-- Total Employees -->
  <div
    class="card-static p-5 group hover-lift stagger-1 animate-fade-in-up"
    role="listitem"
  >
    <div class="flex items-center justify-between mb-4">
      <div
        class="p-2.5 rounded-xl bg-indigo-500/10 border border-indigo-500/20 group-hover:bg-indigo-500/15 transition-colors duration-300"
      >
        <svg
          class="w-5 h-5 text-indigo-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
      </div>
      <div class="status-dot status-dot-active" aria-label="Active"></div>
    </div>
    <p class="text-2xl font-bold text-white tracking-tight" id="stat-employees">
      -
    </p>
    <p class="text-xs text-slate-400 mt-1 font-medium">Total Employees</p>
    <div class="mt-2 flex items-center gap-2">
      <span class="text-xs text-emerald-400 font-medium">Active</span>
      <span class="text-xs text-slate-500">workforce</span>
      <span
        id="stat-employees-depts"
        class="text-xs text-slate-600 ml-auto hidden"
        >· <span id="stat-dept-count">0</span> depts</span
      >
    </div>
  </div>

  <!-- Pending Approvals -->
  <div
    class="card-static p-5 group hover-lift stagger-2 animate-fade-in-up"
    role="listitem"
  >
    <div class="flex items-center justify-between mb-4">
      <div
        class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/20 group-hover:bg-amber-500/15 transition-colors duration-300"
      >
        <svg
          class="w-5 h-5 text-amber-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div class="status-dot status-dot-pending" aria-label="Pending"></div>
    </div>
    <p class="text-2xl font-bold text-white tracking-tight" id="stat-pending">
      -
    </p>
    <p class="text-xs text-slate-400 mt-1 font-medium">Pending Approvals</p>
    <div class="mt-2">
      <span class="text-xs text-amber-400 font-medium">Needs attention</span>
    </div>
  </div>

  <!-- Today's Leave -->
  <div
    class="card-static p-5 group hover-lift stagger-3 animate-fade-in-up"
    role="listitem"
  >
    <div class="flex items-center justify-between mb-4">
      <div
        class="p-2.5 rounded-xl bg-red-500/10 border border-red-500/20 group-hover:bg-red-500/15 transition-colors duration-300"
      >
        <svg
          class="w-5 h-5 text-red-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
      </div>
      <div class="status-dot status-dot-inactive" aria-label="Out of office">
      </div>
    </div>
    <p
      class="text-2xl font-bold text-white tracking-tight"
      id="stat-today-leave"
    >
      -
    </p>
    <p class="text-xs text-slate-400 mt-1 font-medium">Members on Leave Today</p>
    <div class="mt-2">
      <span class="text-xs text-red-400 font-medium">Out of office</span>
    </div>
  </div>

  <!-- Candidates -->
  <div
    class="card-static p-5 group hover-lift stagger-4 animate-fade-in-up"
    role="listitem"
  >
    <div class="flex items-center justify-between mb-4">
      <div
        class="p-2.5 rounded-xl bg-purple-500/10 border border-purple-500/20 group-hover:bg-purple-500/15 transition-colors duration-300"
      >
        <svg
          class="w-5 h-5 text-purple-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
      </div>
      <div class="status-dot status-dot-active" aria-label="In Pipeline"></div>
    </div>
    <p
      class="text-2xl font-bold text-white tracking-tight"
      id="stat-candidates"
    >
      -
    </p>
    <p class="text-xs text-slate-400 mt-1 font-medium">Candidates</p>
    <div class="mt-2 flex items-center gap-2">
      <span class="text-xs text-purple-400 font-medium">In pipeline</span>
      <span
        id="stat-candidate-hired"
        class="text-xs text-slate-600 ml-auto hidden"
        >· <span id="stat-hired-count">0</span> hired</span
      >
    </div>
  </div>
</div>

<script>
  import { api } from "../../services/api";
  import { dashboardMetricsStore, recruitmentStatsStore, departmentsStore } from "../../stores/dataStore";

  let unsubscribes: any[] = [];

  function initStatsGrid() {
    unsubscribes.forEach(unsub => unsub());
    unsubscribes = [];

    // Dashboard metrics (employees, pending, today's leave)
    unsubscribes.push(dashboardMetricsStore.subscribe(m => {
      if (m) {
        const elEmp = document.getElementById("stat-employees");
        if(elEmp) elEmp.textContent = String(m.total_employees ?? 0);
        
        const elPending = document.getElementById("stat-pending");
        if(elPending) elPending.textContent = String(m.pending_approvals ?? 0);
        
        const elLeave = document.getElementById("stat-today-leave");
        if(elLeave) elLeave.textContent = String(m.todays_leave ?? 0);
      } else {
        // Fallback fetch if empty
        api.getDashboardMetrics().then(data => {
          if(data) dashboardMetricsStore.set(data);
        }).catch(() => {});
      }
    }));

    // Recruitment stats (candidates)
    unsubscribes.push(recruitmentStatsStore.subscribe(d => {
      if (d) {
        const elCand = document.getElementById("stat-candidates");
        if(elCand) elCand.textContent = String(d.total_candidates ?? 0);
        
        if (d.hired > 0) {
          const elHired = document.getElementById("stat-candidate-hired");
          if(elHired) elHired.classList.remove("hidden");
          const elHiredCount = document.getElementById("stat-hired-count");
          if(elHiredCount) elHiredCount.textContent = String(d.hired);
        }
      } else {
        // Fallback fetch
        api.get("/api/v1/recruitment/stats").then((res: any) => {
          if(res && res.data) recruitmentStatsStore.set(res.data);
        }).catch(() => {});
      }
    }));

    // Department count
    unsubscribes.push(departmentsStore.subscribe(deps => {
      if (deps && deps.length > 0) {
        const elDepts = document.getElementById("stat-employees-depts");
        if(elDepts) elDepts.classList.remove("hidden");
        const elDeptCount = document.getElementById("stat-dept-count");
        if(elDeptCount) elDeptCount.textContent = String(deps.length);
      } else {
        // Fallback fetch
        api.getDepartments().then((res: any) => {
          if(res && res.data) departmentsStore.set(res.data);
        }).catch(() => {});
      }
    }));
  }

  import { authStore } from "../../stores/index";

  let authUnsub: any = null;
  let isGridInit = false;

  document.addEventListener('astro:page-load', () => {
    if (document.getElementById("stats-grid")) {
      isGridInit = false;
      const checkAndInit = (user: any) => {
        if (!isGridInit && user && ['admin', 'administrator', 'hr'].includes(user.role?.toLowerCase())) {
          initStatsGrid();
          isGridInit = true;
        }
      };

      const user = authStore.get().user;
      checkAndInit(user);

      if (authUnsub) authUnsub();
      authUnsub = authStore.subscribe(state => {
        checkAndInit(state.user);
      });
    } else {
      if (authUnsub) {
        authUnsub();
        authUnsub = null;
      }
    }
  });
</script>
