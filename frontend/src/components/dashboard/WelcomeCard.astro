---
// Welcome card component
---

<div class="relative overflow-hidden rounded-2xl border border-indigo-500/20 bg-gradient-to-br from-indigo-500/10 via-slate-900/80 to-purple-500/10 p-6 lg:p-8">
  <!-- Background decoration -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-purple-500/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2" aria-hidden="true"></div>
  
  <div class="relative flex items-center justify-between">
    <div class="space-y-2">
      <h1 class="text-2xl lg:text-3xl font-bold text-white tracking-tight" id="welcome-greeting">
        Welcome!
      </h1>
      <p class="text-slate-400 text-sm lg:text-base max-w-md leading-relaxed hidden" id="welcome-description">
        Here's what's happening with your HR operations today. You have <span class="text-indigo-400 font-medium" id="pending-count">new updates</span> to review.
      </p>
    </div>
    <div class="hidden md:flex items-center gap-3">
      <div class="w-16 h-16 bg-gradient-to-br from-indigo-500/20 to-purple-500/20 rounded-2xl flex items-center justify-center border border-indigo-500/20 animate-float">
        <svg class="w-8 h-8 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  import { authStore } from '../../stores/index';

  function getGreetingTime() {
    const hour = new Date().getHours();
    if (hour >= 12 && hour < 16) return 'Good afternoon';
    if (hour >= 16 || hour < 4) return 'Good evening';
    return 'Good morning';
  }

  function updateWelcomeCard() {
    const greetingEl = document.getElementById('welcome-greeting');
    const descEl = document.getElementById('welcome-description');
    
    if (!greetingEl || !descEl) return;

    const user = authStore.get().user;
    const timeGreeting = getGreetingTime();

    if (user) {
      // User object has employee_name, not first_name
      let name = 'there';
      if (user.employee_name) {
        name = user.employee_name.split(' ')[0];
      } else if (user.email) {
        name = user.email.split('@')[0];
      }

      if (user.role === 'administrator' || user.role === 'admin' || user.role === 'hr') {
        greetingEl.innerHTML = `${timeGreeting}, ${name}! <span class="text-gradient">Ready to manage your team?</span>`;
        descEl.classList.remove('hidden');
      } else {
        greetingEl.innerHTML = `${timeGreeting}, ${name}!`;
        descEl.classList.add('hidden');
      }
    } else {
      greetingEl.innerHTML = `${timeGreeting}!`;
    }
  }

  // Update when authStore changes or page loads
  authStore.subscribe(() => updateWelcomeCard());
  document.addEventListener('astro:page-load', updateWelcomeCard);
  
  // Initial update
  updateWelcomeCard();
</script>
