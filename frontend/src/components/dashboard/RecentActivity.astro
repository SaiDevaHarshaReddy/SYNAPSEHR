---
const activities = [
  { type: 'leave', message: 'Alex Williams requested casual leave for family vacation', time: '2 hours ago', status: 'pending' },
  { type: 'document', message: 'Experience letter generated for Sarah Johnson', time: '4 hours ago', status: 'completed' },
  { type: 'approval', message: 'Sick leave approved for Jessica Taylor', time: '1 day ago', status: 'approved' },
  { type: 'recruitment', message: 'Meera Krishnan hired as Senior Product Manager', time: '2 days ago', status: 'completed' },
  { type: 'ai', message: 'AI answered 12 policy questions from David Kim', time: '2 days ago', status: 'completed' },
  { type: 'leave', message: 'Priscilla Moore submitted annual leave request', time: '3 days ago', status: 'pending' },
];

const statusColors: Record<string, { dot: string; bg: string }> = {
  pending: { dot: 'bg-amber-400', bg: 'bg-amber-500/10' },
  approved: { dot: 'bg-emerald-400', bg: 'bg-emerald-500/10' },
  completed: { dot: 'bg-indigo-400', bg: 'bg-indigo-500/10' },
};

const typeIcons: Record<string, string> = {
  leave: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  document: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  approval: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  recruitment: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  ai: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
};
---

<div class="card-static">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-lg font-semibold text-white">Recent Activity</h2>
    <a href="/notifications" class="text-sm text-indigo-400 hover:text-indigo-300 font-medium transition-colors duration-200 flex items-center gap-1">
      View all
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
  <div class="space-y-2">
    {activities.map((activity, i) => (
      <div 
        class:list={[
          'flex items-start gap-3 p-3.5 rounded-xl transition-all duration-200',
          'hover:bg-slate-800/40 group',
          'animate-fade-in-up',
        ]}
        style={`animation-delay: ${i * 0.05}s`}
      >
        <div class:list={[
          'w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5',
          statusColors[activity.status]?.bg || 'bg-slate-700/50',
        ]}>
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={typeIcons[activity.type] || typeIcons.leave} />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm text-slate-200 group-hover:text-white transition-colors truncate leading-relaxed">{activity.message}</p>
          <p class="text-xs text-slate-500 mt-1">{activity.time}</p>
        </div>
      </div>
    ))}
  </div>
</div>
