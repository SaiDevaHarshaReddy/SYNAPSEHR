---
interface Props {
  href?: string;
  items: Array<{ label: string; href?: string }>;
  class?: string;
}

const { href, items, class: className = '' } = Astro.props;
---

<nav class:list={['flex items-center text-sm text-slate-400 mb-4', className]}>
  <a href="/dashboard" class="hover:text-white transition-colors">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
    </svg>
  </a>
  {items.map((item, i) => (
    <>
      <svg class="w-4 h-4 mx-2 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
      {item.href ? (
        <a href={item.href} class="hover:text-white transition-colors">{item.label}</a>
      ) : (
        <span class="text-white">{item.label}</span>
      )}
    </>
  ))}
</nav>
