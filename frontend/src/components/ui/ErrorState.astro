---
interface Props {
  title?: string;
  message?: string;
  retryLabel?: string;
  class?: string;
}

const {
  title = 'Something went wrong',
  message = 'An unexpected error occurred. Please try again.',
  retryLabel = 'Try Again',
  class: className = '',
} = Astro.props;
---

<div class:list={['flex flex-col items-center justify-center py-12 px-4', className]}>
  <div class="w-16 h-16 rounded-full bg-red-500/10 flex items-center justify-center mb-4">
    <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
    </svg>
  </div>
  <h3 class="text-lg font-medium text-white mb-1">{title}</h3>
  <p class="text-sm text-slate-400 text-center max-w-sm mb-4">{message}</p>
  <button onclick="window.location.reload()" class="inline-flex items-center px-4 py-2 bg-slate-700 text-white text-sm font-medium rounded-lg hover:bg-slate-600 transition-colors">
    {retryLabel}
  </button>
</div>
